  52  asignacion_multiple : lista_variables ASIG_MULTIPLE lado_derecho_multiple

  53  asignacion_multiple_warning : lista_strict_multiple ASIG lado_derecho_multiple

  54  $$8 :

  55  lado_derecho_multiple : $$8 factor
