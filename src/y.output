  70  parametro_real : parametro_simple FLECHA variable
  71                 | parametro_simple

  72  parametro_simple : expresion
  73                   | lambda_expresion

  74  $$8 :

  75  lambda_expresion : '(' tipo ID ')' '{' $$8 cuerpo_lambda '}'

  76  cuerpo_lambda : sentencias_ejecutables_lista
