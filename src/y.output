  52  expresion : expresion '+' termino
  53            | expresion '-' termino
  54            | termino

  55  termino : termino '*' factor
  56          | termino '/' factor
  57          | factor

  58  factor : factor_no_funcion
  59         | invocacion_funcion

  60  factor_no_funcion : variable
  61                    | constante
  62                    | conversion_explicita

  63  conversion_explicita : TOUI '(' expresion ')'

  64  pre_invocacion :

