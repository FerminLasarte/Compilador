  51                        | lado_derecho_multiple ',' factor

  52  variable : ID PUNTO ID
  53           | ID

  54  expresion : expresion '+' termino
  55            | expresion '-' termino
  56            | termino

  57  termino : termino '*' factor
  58          | termino '/' factor
  59          | factor

  60  factor : factor_no_funcion
  61         | invocacion_funcion

  62  factor_no_funcion : variable
  63                    | constante
  64                    | conversion_explicita

  65  conversion_explicita : TOUI '(' expresion ')'

  66  pre_invocacion :

  67  invocacion_funcion : ID pre_invocacion '(' lista_parametros_reales ')'

  68  lista_parametros_reales : lista_parametros_reales ',' parametro_real
