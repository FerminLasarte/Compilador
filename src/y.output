  75  parametro_real : parametro_simple FLECHA variable
  76                 | parametro_simple

  77  parametro_simple : expresion
  78                   | lambda_expresion

  79  $$9 :

  80  lambda_expresion : '(' tipo ID ')' '{' $$9 cuerpo_lambda '}'

  81  $$10 :

