  84                               | declaracion_ilegal

  85  declaracion_ilegal : VAR variable ASIG expresion fin_sentencia
  86                     | VAR variable fin_sentencia

  87  constante : CTE
  88            | '-' CTE

  89  if_encabezado : IF '(' condicion ')'
  90                | IF '(' error ')'

  91  inicio_else : ELSE

  92  condicional_if : if_encabezado bloque_ejecutable ENDIF ';'
