  31  lista_parametros_formales : lista_parametros_formales ',' parametro_formal
  32                            | parametro_formal

  33  parametro_formal : sem_pasaje tipo ID
  34                   | tipo ID
  35                   | sem_pasaje ID

  36  sem_pasaje : CR SE
  37             | CR LE

  38  sentencia_ejecutable : asignacion fin_sentencia
  39                       | asignacion_multiple fin_sentencia
  40                       | asignacion_multiple_warning fin_sentencia
  41                       | condicional_if
  42                       | condicional_do_while
  43                       | salida_pantalla fin_sentencia
  44                       | retorno_funcion
  45                       | invocacion_funcion fin_sentencia

  46  asignacion : variable ASIG expresion
  47             | conversion_explicita ASIG expresion

  48  asignacion_multiple : lista_variables ASIG_MULTIPLE lado_derecho_multiple

  49  asignacion_multiple_warning : lista_strict_multiple ASIG lado_derecho_multiple

  50  $$7 :

  51  lado_derecho_multiple : $$7 factor
  52                        | lado_derecho_multiple ',' factor

  53  variable : ID PUNTO ID
  54           | ID

  55  expresion : expresion '+' termino
  56            | expresion '-' termino
  57            | termino

  58  termino : termino '*' factor
  59          | termino '/' factor
  60          | factor

  61  factor : factor_no_funcion
  62         | invocacion_funcion

  63  factor_no_funcion : variable
  64                    | constante
  65                    | conversion_explicita

  66  conversion_explicita : TOUI '(' expresion ')'

  67  pre_invocacion :

  68  invocacion_funcion : ID pre_invocacion '(' lista_parametros_reales ')'

  69  lista_parametros_reales : lista_parametros_reales ',' parametro_real
  70                          | parametro_real

  71  parametro_real : parametro_simple FLECHA variable
  72                 | parametro_simple

  73  parametro_simple : expresion
  74                   | lambda_expresion

  75  $$8 :

  76  lambda_expresion : '(' tipo ID ')' '{' $$8 cuerpo_lambda '}'

  77  cuerpo_lambda : sentencias_ejecutables_lista
  78                |

  79  sentencias_ejecutables_lista : sentencias_ejecutables_lista sentencia_ejecutable
  80                               | sentencia_ejecutable
  81                               | sentencias_ejecutables_lista declaracion_ilegal
  82                               | declaracion_ilegal

  83  declaracion_ilegal : VAR variable ASIG expresion fin_sentencia
  84                     | VAR variable fin_sentencia

  85  constante : CTE
  86            | '-' CTE

  87  if_encabezado : IF '(' condicion ')'
  88                | IF '(' error ')'

  89  inicio_else : ELSE

  90  condicional_if : if_encabezado bloque_ejecutable ENDIF ';'
  91                 | if_encabezado bloque_ejecutable inicio_else bloque_ejecutable ENDIF ';'
  92                 | if_encabezado bloque_ejecutable ENDIF error
  93                 | if_encabezado bloque_ejecutable inicio_else bloque_ejecutable ENDIF error
  94                 | if_encabezado bloque_ejecutable error

  95  $$9 :

  96  condicional_do_while : DO $$9 bloque_ejecutable WHILE '(' condicion ')' fin_sentencia

  97  condicion : expresion simbolo_comparacion expresion

  98  simbolo_comparacion : MAYOR_IGUAL
