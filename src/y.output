  73  if_encabezado : IF '(' condicion ')'

  74  condicional_if : if_encabezado bloque_ejecutable ENDIF ';'

  75  $$9 :

  76  condicional_if : if_encabezado bloque_ejecutable ELSE $$9 bloque_ejecutable ENDIF ';'

  77  $$10 :

  78  condicional_do_while : DO $$10 bloque_ejecutable WHILE '(' condicion ')' ';'

  79  condicion : expresion simbolo_comparacion expresion

