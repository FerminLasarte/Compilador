  57  variable : ID PUNTO ID
  58           | ID

  59  expresion : expresion '+' termino
  60            | expresion '-' termino
  61            | termino

  62  termino : termino '*' factor
  63          | termino '/' factor
  64          | factor

  65  factor : factor_no_funcion
  66         | invocacion_funcion

  67  factor_no_funcion : variable
  68                    | constante
  69                    | conversion_explicita

  70  conversion_explicita : TOUI '(' expresion ')'

  71  pre_invocacion :

  72  invocacion_funcion : ID pre_invocacion '(' lista_parametros_reales ')'

  73  lista_parametros_reales : lista_parametros_reales ',' parametro_real
