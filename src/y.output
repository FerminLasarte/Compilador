  44  variable : ID PUNTO ID
  45           | ID

  46  expresion : expresion '+' termino
  47            | expresion '-' termino
  48            | termino

  49  termino : termino '*' factor
  50          | termino '/' factor
  51          | factor

  52  factor : factor_no_funcion
  53         | invocacion_funcion

  54  factor_no_funcion : variable
  55                    | constante
  56                    | conversion_explicita

  57  conversion_explicita : TOUI '(' expresion ')'

  58  pre_invocacion :

