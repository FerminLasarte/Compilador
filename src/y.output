  91  constante : CTE
  92            | '-' CTE

  93  if_encabezado : IF '(' condicion ')'
  94                | IF '(' error ')'

  95  inicio_else : ELSE

  96  condicional_if : if_encabezado bloque_ejecutable ENDIF ';'
