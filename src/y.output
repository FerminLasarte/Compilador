   7  fin_sentencia : ';'
   8                |

   9  sentencias : sentencias sentencia
  10             | sentencia

  11  sentencia : sentencia_declarativa
  12            | sentencia_ejecutable
  13            | error ';'

  14  sentencia_declarativa : funcion
  15                        | declaracion_var fin_sentencia

  16  declaracion_var : VAR variable ASIG expresion
  17                  | VAR variable ':' error

  18  tipo : UINT
  19       | FLOAT
  20       | LAMBDA

  21  lista_variables : variable
