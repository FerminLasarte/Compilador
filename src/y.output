  26  funcion : tipo ID '(' lista_parametros_formales ')' '{' $$5 sentencias '}'

  27  $$6 :

  28  funcion : lista_tipos_retorno_multiple ID '(' lista_parametros_formales ')' '{' $$6 sentencias '}'

  29  lista_tipos_retorno_multiple : tipo ',' tipo
