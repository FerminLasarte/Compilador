  97  $$10 :

  98  parte_do_while : DO $$10 bloque_ejecutable WHILE

  99  condicional_do_while : parte_do_while '(' condicion ')' fin_sentencia
 100                       | parte_do_while condicion fin_sentencia
 101                       | parte_do_while '(' ')' fin_sentencia

