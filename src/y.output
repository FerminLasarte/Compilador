  62  parametro_real : parametro_simple FLECHA variable
  63                 | parametro_simple

  64  parametro_simple : expresion
  65                   | lambda_expresion

  66  $$8 :

  67  lambda_expresion : '(' tipo ID ')' '{' $$8 cuerpo_lambda '}'

  68  cuerpo_lambda : sentencias_ejecutables_lista

  69  sentencias_ejecutables_lista : sentencias_ejecutables_lista sentencia_ejecutable
