  53            | termino

  54  termino : termino '*' factor
  55          | termino '/' factor
  56          | factor

  57  factor : factor_no_funcion
  58         | invocacion_funcion

  59  factor_no_funcion : variable
  60                    | constante
  61                    | conversion_explicita

  62  conversion_explicita : TOUI '(' expresion ')'

