  26  lista_parametros_formales : lista_parametros_formales ',' parametro_formal
  27                            | parametro_formal

  28  parametro_formal : sem_pasaje tipo ID
  29                   | tipo ID

  30  sem_pasaje : CR SE
  31             | CR LE

  32  sentencia_ejecutable : asignacion ';'
  33                       | asignacion_multiple ';'
  34                       | condicional_if
  35                       | condicional_do_while
  36                       | salida_pantalla ';'
  37                       | retorno_funcion
  38                       | invocacion_funcion ';'

  39  asignacion : variable ASIG expresion

  40  asignacion_multiple : lista_variables ASIG_MULTIPLE lado_derecho_multiple

  41  $$7 :

  42  lado_derecho_multiple : $$7 factor
  43                        | lado_derecho_multiple ',' factor

  44  variable : ID PUNTO ID
  45           | ID

  46  expresion : expresion '+' termino
  47            | expresion '-' termino
  48            | termino

  49  termino : termino '*' factor
  50          | termino '/' factor
  51          | factor

  52  factor : factor_no_funcion
  53         | invocacion_funcion

  54  factor_no_funcion : variable
  55                    | constante
  56                    | conversion_explicita

  57  conversion_explicita : TOUI '(' expresion ')'

  58  pre_invocacion :

  59  invocacion_funcion : ID pre_invocacion '(' lista_parametros_reales ')'

  60  lista_parametros_reales : lista_parametros_reales ',' parametro_real
