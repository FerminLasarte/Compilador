  31  lista_parametros_formales : lista_parametros_formales ',' parametro_formal
  32                            | parametro_formal

  33  parametro_formal : sem_pasaje tipo ID
  34                   | tipo ID
  35                   | sem_pasaje ID

  36  sem_pasaje : CR SE
  37             | CR LE

  38  sentencia_ejecutable : asignacion fin_sentencia
