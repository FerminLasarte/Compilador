   1: @ Expresiones Lambda en Pasaje de Parámetros
   2: PROGRAMA {
   3:     uint FUNCION(lambda B, uint C) {
   4:         B(C);
   5:         return(C);
   6:     }
   7: 
   8:     FUNCION((uint A) {
   9:         print(A);
  10:         if(A > 3UI) {
  11:             print(&Imprime Lambda Positivo&);
  12:         } else {
  13:             print(&Imprime Lambda Negativo&);
  14:         } endif;
  15:     }->B, 5UI->C);
  16: }
