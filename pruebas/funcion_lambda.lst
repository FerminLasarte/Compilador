LISTADO DE COMPILACION: funcion_lambda.txt
----------------------------------------
   1: @ Expresiones Lambda en Pasaje de Parámetros
   2: PROGRAMA {
   3:     uint FUNCION(lambda B, uint C) {
   4:         B(C);
   5:         print(C);
   6:         return(C);
   7:     }
   8: 
   9:     FUNCION((uint A) {
  10:         print(A);
  11:         if(A > 3UI) {
  12:             print(&Imprime Lambda Positivo&);
  13:         } else {
  14:             print(&Imprime Lambda Negativo&);
  15:             A := A - 1UI;
  16:         } endif;
  17:     }->B, 5UI->C);
  18: }
