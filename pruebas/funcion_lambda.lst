LISTADO DE COMPILACION: funcion_lambda.txt
----------------------------------------
   1: @ Expresiones Lambda en Pasaje de Parámetros
   2: PROGRAMA {
   3:     var A := 5UI;
   4:     uint FUNCION(lambda B, uint C) {
   5:         B(C);
   6:         return(C);
   7:     }
   8: 
   9:     FUNCION((uint A) {
  10:         if(A > 3UI) {
  11:             print(&Imprime Lambda Positivo&);
  12:         } else {
  13:             print(&Imprime Lambda Negativo&);
  14:             A := A - 1UI;
  15:         } endif;
  16:     }->B, 5UI->C);
  17: }
