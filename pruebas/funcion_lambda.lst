LISTADO DE COMPILACION: funcion_lambda.txt
----------------------------------------
   1: @ Expresiones Lambda en Pasaje de Parámetros
   2: PROGRAMA {
   3:     var A := 5UI;
   4:     uint FUNCION(lambda B, uint C) {
   5:         B(C);
   6:     }
   7: 
   8:     FUNCION((uint A) {
   9:         if(PROGRAMA.A > 3UI) {
  10:             print(&Imprime Lambda Positivo&);
  11:         } else {
  12:             print(&Imprime Lambda Negativo&);
  13:             PROGRAMA.A := PROGRAMA.A - 1UI;
  14:         } endif;
  15:     }->B, 5UI->C);
  16: }
