LISTADO DE COMPILACION: funcion_lambda_sin_return.txt
----------------------------------------
   1: @ Expresiones Lambda en Pasaje de Parámetros
   2: PROGRAMA {
   3:     uint FUNCION(lambda B, uint C) {
   4:         B(C);
   5:         print(C);
   6:     }
   7: 
   8:     FUNCION((uint A) {
   9:         if(A > 3UI) {
  10:             print(&Imprime Lambda Positivo&);
  11:         } else {
  12:             print(&Imprime Lambda Negativo&);
  13:         } endif;
  14:     }->B, 5UI->C);
  15: }
