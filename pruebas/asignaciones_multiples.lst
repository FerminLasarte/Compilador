LISTADO DE COMPILACION: asignaciones_multiples.txt
----------------------------------------
   1: @ Asignaciones con igual número de elementos de ambos lados de la asignación
   2: PROGRAMA {
   3:     var A := 0UI;
   4:     var B := 0UI;
   5:     var C := 0UI;
   6: 
   7:     uint FUNCION(uint X) {
   8:         X := 5UI * 2UI;
   9:         print(X);
  10:         return(X);
  11:     }
  12: 
  13:     A, B, C = 1UI, 2UI, 3UI;
  14:     print(A);
  15:     print(B);
  16:     print(C);
  17: 
  18:     A, B = 8UI, FUNCION(0UI->X);
  19: }
