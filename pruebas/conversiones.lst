LISTADO DE COMPILACION: conversiones.txt
----------------------------------------
   1: @ Conversiones explícitas de Punto Flotante a Entero
   2: PROGRAMA {
   3:     var A := 5UI;
   4:     var B := 5.0F+0;
   5:     var D := 15.2F+0;
   6: 
   7:     var C := A + toui(B);
   8:     print(&C = 10&);
   9:     print(C);
  10:     C := toui(D + B);
  11:     print(&C = 20&);
  12:     print(C);
  13:     var E := A + toui(2.5F+0);
  14:     print(&E = 7&);
  15:     print(E);
  16: }
